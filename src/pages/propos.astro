---
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';
import Hero from '../components/hero.astro';
import '../styles/global.css';
import Layout from '../layouts/Layout.astro';
---

<Layout>
    <Header />
    <Hero />
    <section class="w-full py-16 bg-[#101c2b] min-h-[50vh]">
  <div class="max-w-2xl mx-auto px-4">
    <h2 class="text-white text-5xl font-light mb-10">À propos de moi</h2>
    <div class="text-white/80 text-base leading-relaxed space-y-4">
      <p>
        Je m'appelle Gautier Vicat, passionné par la création visuelle et l'expérience utilisateur.  
        Grâce à une solide formation et une curiosité naturelle pour le design et le numérique, j'ai développé un profil polyvalent mêlant technique, créativité et communication.
      </p>

      <p>
        Au fil de mon parcours, j'ai évolué du graphisme aux interfaces en passant par le développement web et l'audiovisuel. J’aime concevoir des identités et des expériences interactives, centrées sur l'utilisateur.
      </p>
      <p>
        Aujourd’hui, je recherche sans cesse des projets qui rassemblent création graphique, storytelling et design UX/UI pour créer des solutions à la fois esthétiques et utiles.  
        Retrouvez ci-dessous un aperçu de mes réalisations les plus récentes.
      </p>
    </div>
  </div>
</section>
<section class="w-full py-20 bg-[#101c2b]">
  <div class="max-w-7xl mx-auto flex flex-col gap-10">
    <h2 class="text-[#bcff69] text-4xl font-bold mb-8 px-2">Mes compétences</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="bg-[#161e2d] rounded-2xl p-6 shadow-lg">
        <h3 class="text-[#6d7ffc] text-xl font-semibold mb-6">Design Graphique</h3>
        <div class="mb-4">
          <div class="flex items-center justify-between text-white text-[15px] mb-2">
            <div class="flex items-center gap-3">
              <img src="/id.webp" alt="InDesign" class="w-8 h-8 object-contain" />
              <span>Adobe InDesign</span>
            </div>
            <span>90%</span>
          </div>
          <div class="h-2 bg-[#182235] rounded">
            <div class="bg-[#bcff69] h-2 rounded" style="width: 90%;"></div>
          </div>
        </div>
        <div class="mb-4">
          <div class="flex items-center justify-between text-white text-[15px] mb-2">
            <div class="flex items-center gap-3">
              <img src="/ai.webp" alt="Illustrator" class="w-8 h-8 object-contain" />
              <span>Adobe Illustrator</span>
            </div>
            <span>85%</span>
          </div>
          <div class="h-2 bg-[#182235] rounded">
            <div class="bg-[#bcff69] h-2 rounded" style="width: 85%;"></div>
          </div>
        </div>
        <div class="mb-4">
          <div class="flex items-center justify-between text-white text-[15px] mb-2">
            <div class="flex items-center gap-3">
              <img src="/ps.webp" alt="Photoshop" class="w-8 h-8 object-contain" />
              <span>Adobe Photoshop</span>
            </div>
            <span>88%</span>
          </div>
          <div class="h-2 bg-[#182235] rounded">
            <div class="bg-[#bcff69] h-2 rounded" style="width: 88%;"></div>
          </div>
        </div>
        <div>
          <div class="flex items-center justify-between text-white text-[15px] mb-2">
            <div class="flex items-center gap-3">
              <img src="/figma.webp" alt="Figma" class="w-8 h-8 object-contain" />
              <span>Figma</span>
            </div>
            <span>92%</span>
          </div>
          <div class="h-2 bg-[#182235] rounded">
            <div class="bg-[#bcff69] h-2 rounded" style="width: 92%;"></div>
          </div>
        </div>
      </div>
      <div class="bg-[#161e2d] rounded-2xl p-6 shadow-lg">
        <h3 class="text-[#6d7ffc] text-xl font-semibold mb-6">Développement</h3>
        <div class="mb-4">
          <div class="flex items-center justify-between text-white text-[15px] mb-2">
            <div class="flex items-center gap-3">
              <img src="/html.webp" alt="HTML/CSS" class="w-8 h-8 object-contain" />
			  <img src="/css.webp" alt="HTML/CSS" class="w-8 h-8 object-contain" />
              <span>HTML/CSS</span>
            </div>
            <span>85%</span>
          </div>
          <div class="h-2 bg-[#182235] rounded">
            <div class="bg-[#bcff69] h-2 rounded" style="width: 85%;"></div>
          </div>
        </div>
        <div class="mb-4">
          <div class="flex items-center justify-between text-white text-[15px] mb-2">
            <div class="flex items-center gap-3">
              <img src="/js.webp" alt="JavaScript" class="w-8 h-8 object-contain" />
              <span>JavaScript</span>
            </div>
            <span>75%</span>
          </div>
          <div class="h-2 bg-[#182235] rounded">
            <div class="bg-[#bcff69] h-2 rounded" style="width: 75%;"></div>
          </div>
        </div>
      </div>
      <div class="bg-[#161e2d] rounded-2xl p-6 shadow-lg">
        <h3 class="text-[#6d7ffc] text-xl font-semibold mb-6">Prototypage & UX</h3>
        <div>
          <div class="flex items-center justify-between text-white text-[15px] mb-2">
            <div class="flex items-center gap-3">
              <img src="/xd.webp" alt="Adobe XD" class="w-8 h-8 object-contain" />
              <span>Adobe XD</span>
            </div>
            <span>88%</span>
          </div>
          <div class="h-2 bg-[#182235] rounded">
            <div class="bg-[#bcff69] h-2 rounded" style="width: 88%;"></div>
          </div>
        </div>
      </div>
      <div class="bg-[#161e2d] rounded-2xl p-6 shadow-lg">
        <h3 class="text-[#6d7ffc] text-xl font-semibold mb-6">Vidéo & Animation</h3>
        <div class="mb-4">
          <div class="flex items-center justify-between text-white text-[15px] mb-2">
            <div class="flex items-center gap-3">
              <img src="/pr.webp" alt="Premiere Pro" class="w-8 h-8 object-contain" />
              <span>Premiere Pro</span>
            </div>
            <span>80%</span>
          </div>
          <div class="h-2 bg-[#182235] rounded">
            <div class="bg-[#bcff69] h-2 rounded" style="width: 80%;"></div>
          </div>
        </div>
        <div>
          <div class="flex items-center justify-between text-white text-[15px] mb-2">
            <div class="flex items-center gap-3">
              <img src="/ae.webp" alt="After Effects" class="w-8 h-8 object-contain" />
              <span>After Effects</span>
            </div>
            <span>75%</span>
          </div>
          <div class="h-2 bg-[#182235] rounded">
            <div class="bg-[#bcff69] h-2 rounded" style="width: 75%;"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
    <Footer /> 
</Layout>